--- client/convex/schema.ts
+++ client/convex/schema.ts
@@ -48,5 +48,25 @@
     message: v.string(),
     isRead: v.boolean(),
     createdAt: v.number(),
   }).index("by_user", ["targetUserId"]),
+
+  polls: defineTable({
+    meetingId: v.string(),
+    question: v.string(),
+    options: v.array(v.object({ id: v.string(), text: v.string(), votes: v.number() })),
+    votedUsers: v.array(v.string()), 
+    isActive: v.boolean(),
+    createdBy: v.string(),
+    createdAt: v.number(),
+  }).index("by_meeting", ["meetingId"]),
+
+  breakoutRooms: defineTable({
+    meetingId: v.string(),
+    rooms: v.array(v.object({
+      id: v.string(),
+      name: v.string(),
+      participants: v.array(v.string())
+    })),
+    status: v.union(v.literal("active"), v.literal("closed")),
+  }).index("by_meeting", ["meetingId", "status"]),
 });
