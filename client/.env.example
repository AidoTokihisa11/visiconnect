# ============================================
# 🔧 VisiConnect - Client Configuration
# ============================================
# INSTRUCTIONS :
# 1. Copier ce fichier en .env : cp .env.example .env
# 2. Remplir les valeurs avec vos vraies clés
# 3. NE JAMAIS commit le fichier .env !
# ============================================

# ============================================
# 📊 Supabase Configuration
# ============================================
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️ IMPORTANT : Utiliser UNIQUEMENT la clé ANON côté client
# Ne JAMAIS utiliser la SERVICE_ROLE_KEY ici !

# ============================================
# 🔐 STACK AUTH (Authentification)
# ============================================
# Project ID de ton projet Stack Auth
REACT_APP_STACK_PROJECT_ID=your-stack-project-id

# Clé publique Stack Auth (safe pour le client)
REACT_APP_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-key

# ⚠️ IMPORTANT : Utiliser UNIQUEMENT les clés PUBLISHABLE
# Ne JAMAIS mettre de clés SECRET/ADMIN côté client !

# ============================================
# 🌐 API Configuration
# ============================================
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# ============================================
# 🔄 WebRTC Configuration (Optionnel)
# ============================================
# Configuration des serveurs STUN/TURN pour NAT traversal
REACT_APP_STUN_SERVER=stun:stun.l.google.com:19302
# REACT_APP_TURN_SERVER=turn:your-turn-server.com:3478
# REACT_APP_TURN_USERNAME=your_turn_username
# REACT_APP_TURN_CREDENTIAL=your_turn_password

# ============================================
# 🎨 Application Configuration
# ============================================
REACT_APP_NAME=VisiConnect
REACT_APP_VERSION=1.0.0

REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# ============================================
# NOTES IMPORTANTES
# ============================================
# 1. Ne JAMAIS commit le fichier .env avec des vraies valeurs
# 2. Utilise .env.local pour le développement local
# 3. Configure les variables d'environnement sur Netlify pour la production
# 4. Le token Stack Auth JWT est géré automatiquement par le SDK
# 5. Les RLS policies de Neon sécurisent automatiquement l'accès aux données
