# ============================================
# 🔧 VisioConnect — Client (Vite)
# ============================================
# 1. Copier ce fichier :  cp .env.example .env.local
# 2. Remplir avec vos vraies valeurs
# 3. NE JAMAIS commit .env / .env.local
#
# ⚠️ Vite INLINE ces variables dans le bundle au moment du build.
#    Tout ce qui est ici est PUBLIC : n'y mettre que des clés "publishable".
#    Une valeur placeholder fait échouer le build (voir vite.config.js).
# ============================================

# --------------------------------------------
# 🔴 REQUIS — le build échoue sans ces valeurs
# --------------------------------------------
# Backend Convex (Dashboard Convex > Settings > Deployment URL)
VITE_CONVEX_URL=https://votre-deployment.convex.cloud

# Authentification Clerk (Dashboard Clerk > API Keys > Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_remplacez_moi

# --------------------------------------------
# 🟡 OPTIONNEL
# --------------------------------------------
# API Express / routes serverless (vide = même origine)
VITE_API_URL=http://localhost:3000

# Endpoint HTTP Actions Convex (webhooks Stripe/Clerk)
VITE_CONVEX_SITE_URL=

# Serveur LiveKit (WebRTC SFU)
VITE_LIVEKIT_URL=ws://localhost:7880

# Stripe — clé publishable uniquement (jamais de sk_)
VITE_STRIPE_PUBLISHABLE_KEY=

# Licence tldraw pour le whiteboard collaboratif
VITE_TLDRAW_LICENSE_KEY=

# Analytics — chargés uniquement après consentement cookies
VITE_GA_MEASUREMENT_ID=
VITE_HOTJAR_ID=
VITE_META_PIXEL_ID=

# Mode démo (bypass la création réelle de réunion)
VITE_DEMO_MODE=false
