{
  "name": "visiconnect",
  "version": "1.0.0",
  "description": "Plateforme de visioconférence moderne avec authentification sécurisée",
  "main": "server/index.js",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build": "npm run build:client && npm run build:server",
    "env:encrypt": "node scripts/env-crypto.js encrypt",
    "env:decrypt": "node scripts/env-crypto.js decrypt",
    "start": "npm run dev"
  },
  "keywords": [
    "visioconference",
    "webrtc",
    "react",
    "nodejs",
    "socket.io",
    "video-chat",
    "real-time"
  ],
  "author": "AidoTokihisa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AidoTokihisa11/visiconnect.git"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@livekit/components-react": "^2.9.20",
    "@stripe/stripe-js": "^8.8.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "tldraw": "^4.4.0",
    "zustand": "^5.0.11"
  }
}
