{
  "name": "visiconnect",
  "version": "1.0.0",
  "description": "Plateforme de visioconférence moderne avec authentification sécurisée",
  "main": "server/index.js",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm install --legacy-peer-deps && npm run build && cd .. && rm -rf build && cp -r client/build build",
    "build:server": "cd server && npm run build",
    "build": "npm run build:client",
    "env:encrypt": "node scripts/env-crypto.js encrypt",
    "env:decrypt": "node scripts/env-crypto.js decrypt",
    "start": "npm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:server": "cd server && npm test",
    "audit:high": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "visioconference",
    "webrtc",
    "react",
    "nodejs",
    "socket.io",
    "video-chat",
    "real-time"
  ],
  "author": "AidoTokihisa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AidoTokihisa11/visiconnect.git"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.15.0",
    "@react-email/preview-server": "^5.2.10",
    "@react-email/ui": "^6.0.0",
    "@tolgee/cli": "^2.16.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "bing-translate-api": "^4.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.21.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@livekit/components-react": "^2.9.20",
    "@react-email/components": "^1.0.12",
    "@stripe/stripe-js": "^8.8.0",
    "convex": "^1.33.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "react-email": "^5.2.10",
    "react-i18next": "^16.5.4",
    "recharts": "^3.7.0",
    "recordrtc": "^5.6.2",
    "resend": "^6.11.0",
    "socket.io-client": "^4.8.3",
    "tldraw": "^4.4.0",
    "zustand": "^5.0.11"
  }
}
