# ============================================
# 🔧 VisiConnect - Server Configuration
# ============================================
# INSTRUCTIONS :
# 1. Copier ce fichier en .env : cp .env.example .env
# 2. Remplir les valeurs avec vos vraies clés
# 3. NE JAMAIS commit le fichier .env !
# ============================================

# ============================================
# 📊 Supabase Configuration
# ============================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ⚠️ IMPORTANT : Le SERVICE_ROLE_KEY doit rester SECRET
# Il donne accès COMPLET à la base de données (bypass RLS)
# Ne JAMAIS l'utiliser côté client !

# ============================================
# 🔐 Stack Auth Configuration
# ============================================
STACK_PROJECT_ID=your_stack_project_id
STACK_PUBLISHABLE_CLIENT_KEY=your_publishable_key
STACK_SECRET_SERVER_KEY=your_secret_server_key
STACK_SUPER_SECRET_ADMIN_KEY=your_super_secret_admin_key

# ⚠️ IMPORTANT : Les clés SECRET et SUPER_SECRET ne doivent
# JAMAIS être exposées côté client !

# ============================================
# 🗄️ Database Configuration (Legacy/Backup)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ============================================
# 🌐 Server Configuration
# ============================================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============================================
# 🎥 LiveKit Configuration
# ============================================
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ============================================
# 🔄 WebRTC / TURN Configuration (Optionnel)
# ============================================
# Si vous utilisez un serveur TURN pour NAT traversal
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_password

# ============================================
# 📧 Email Configuration (Optionnel)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password

# ============================================
# 🛡️ Security
# ============================================
JWT_SECRET=your_random_jwt_secret_here_min_32_characters
SESSION_SECRET=your_random_session_secret_here_min_32_characters

# Pour générer des secrets aléatoires :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================
# 📊 Monitoring & Logging
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# 🚀 Deployment
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.netlify.app
